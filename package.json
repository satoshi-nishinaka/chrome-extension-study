{
  "name": "short-cut-extension",
  "version": "2.1.7",
  "description": "short-cut-extension",
  "main": "index.js",
  "scripts": {
    "watch": "npm run watch:chrome",
    "watch:chrome": "webpack --config webpack/webpack.dev.js --env browser=chrome --watch",
    "watch:firefox": "webpack --config webpack/webpack.dev.js --env browser=firefox --watch",
    "build": "npm run clean && npm run build:chrome && npm run build:firefox && npm run test:manifests",
    "build:chrome": "webpack --config webpack/webpack.prod.js --env browser=chrome",
    "build:firefox": "webpack --config webpack/webpack.prod.js --env browser=firefox",
    "clean": "rimraf dist",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "run:firefox": "web-ext run --source-dir dist/firefox",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir artifacts --overwrite-dest",
    "sign:firefox": "web-ext sign --source-dir dist/firefox --artifacts-dir artifacts --channel=unlisted",
    "test": "npx jest --config src/jest.config.ts",
    "test:manifests": "node scripts/validate-manifests.js",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src"
  },
  "author": "satoshi-nishinaka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/satoshi-nishinaka/chrome-extension-study.git"
  },
  "dependencies": {
    "bootstrap": "^5.3.7",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.14.1",
    "moment": "~2.29.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.326",
    "@types/jest": "^29.5.14",
    "@types/jquery": "^3.5.32",
    "@types/jqueryui": "^1.12.24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.2.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "mini-css-extract-plugin": "^2.9.2",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "web-ext": "^10.7.0",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
